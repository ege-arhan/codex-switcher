  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Neutral primary account action; light-mode reference, with source-defined dark reversal.",
      "html": "<button class=\"ds-primary\">Switch</button>",
      "css": ".ds-primary {font-family:var(--app-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif); font-size:14px; line-height:20px; border-radius:var(--control-radius,7px); padding:8px 16px; cursor:pointer; color:var(--surface,#fff); background:var(--neutral-900,#202027); border:0; transition:background-color 150ms;} .ds-primary:hover {background:var(--neutral-800,#2e2e36);} .ds-primary:focus-visible { outline: 2px solid var(--accent, #006bd6); outline-offset: 3px; } .ds-primary:disabled {opacity:.5;cursor:not-allowed;}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tonal dismissal or secondary action.",
      "html": "<button class=\"ds-secondary\">Done</button>",
      "css": ".ds-secondary {font-family:var(--app-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif); font-size:14px; line-height:20px; border-radius:var(--control-radius,7px); padding:8px 16px; cursor:pointer; background:var(--neutral-100,#eeeeef);color:var(--neutral-700,#41414b);border:0;} .ds-secondary:hover {background:var(--neutral-200,#dedee2);} .ds-secondary:focus-visible { outline: 2px solid var(--accent, #006bd6); outline-offset: 3px; } .ds-secondary:disabled {opacity:.5;}"
    },
    {
      "name": "Claude outlined action",
      "kind": "button",
      "refersTo": "button-claude",
      "description": "Outlined provider action with its own focus accent.",
      "html": "<button class=\"ds-claude\">Open Claude Code</button>",
      "css": ".ds-claude {font-family:var(--app-font, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif); font-size:14px; line-height:20px; border-radius:var(--control-radius,7px); padding:8px 16px; cursor:pointer; padding:8px 12px;background:transparent;border:1px solid var(--neutral-300,#c8c8ce);color:var(--neutral-800,#2e2e36);font-weight:500;} .ds-claude:hover {background:var(--neutral-100,#eeeeef);} .ds-claude:focus-visible {outline:2px solid #d97757;outline-offset:2px;} .ds-claude:disabled {opacity:.5;}"
    },
    {
      "name": "Settings field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled settings input with visible keyboard focus.",
      "html": "<label class=\"ds-field-label\">Resume prompt<input class=\"ds-field\" value=\"Continue\" /></label>",
      "css": ".ds-field-label {display:grid;gap:4px;font:500 12px/16px var(--app-font,sans-serif);color:var(--neutral-900,#202027);} .ds-field {font:400 14px/20px var(--app-font,sans-serif);padding:8px 12px;background:var(--surface,#fff);color:var(--neutral-900,#202027);border:1px solid var(--neutral-300,#c8c8ce);border-radius:var(--control-radius,7px);} .ds-field:hover {border-color:var(--neutral-500,#676773);} .ds-field:focus-visible { outline: 2px solid var(--accent, #006bd6); outline-offset: 3px; }"
    },
    {
      "name": "Provider navigation",
      "kind": "nav",
      "refersTo": "provider-tab",
      "description": "Account-count segments in the common provider header. Shared privacy, refresh, warm-up, settings and account commands route to the selected provider. Automatic switch and automatic warm-up retain separate provider state; theme appearance applies to both screens.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Accounts\"><button aria-pressed=\"true\">Codex</button><button aria-pressed=\"false\">Claude</button></nav>",
      "css": ".ds-nav {display:flex;width:fit-content;gap:3px;padding:3px;background:var(--neutral-200,#dedee2);border-radius:var(--control-radius,7px);}.ds-nav button {font:600 13px/20px var(--app-font,sans-serif);padding:7px 18px;border:1px solid transparent;border-radius:var(--control-radius,7px);color:var(--neutral-900,#202027);background:transparent;cursor:pointer;}.ds-nav button[aria-pressed=\"true\"] {background:var(--surface,#fff);border-color:var(--neutral-300,#c8c8ce);box-shadow:0 1px 2px #0000000a;}.ds-nav button:focus-visible { outline: 2px solid var(--accent, #006bd6); outline-offset: 3px; }"
    },
    {
      "name": "Account card",
      "kind": "card",
      "refersTo": "account-card",
      "description": "Neutral account container with anonymous identity and supporting timestamp.",
      "html": "<article class=\"ds-card\"><h3>Account name</h3><p>Last updated: Just now</p></article>",
      "css": ".ds-card {padding:16px;background:var(--surface,#fff);border:1px solid var(--neutral-200,#dedee2);border-radius:var(--radius,12px);font-family:var(--app-font,sans-serif);font-variant-numeric:tabular-nums;}.ds-card h3 {margin:0;color:var(--neutral-900,#202027);font-size:16px;line-height:24px;font-weight:600;}.ds-card p {margin:12px 0 0;color:var(--neutral-500,#676773);font-size:12px;line-height:16px;}.ds-card:hover {border-color:var(--neutral-300,#c8c8ce);}"
    },
    {
      "name": "Claude plan badge",
      "kind": "chip",
      "refersTo": "plan-badge",
      "description": "Bordered provider plan chip; dark mode uses a light orange label.",
      "html": "<span class=\"ds-plan\">Pro</span>",
      "css": ".ds-plan {display:inline-block;padding:4px 8px;border:1px solid #d97757;border-radius:9999px;font:500 12px/16px var(--app-font,sans-serif);color:#7c2d12;}"
    },
    {
      "name": "Remaining quota",
      "kind": "custom",
      "refersTo": "quota-track",
      "description": "Anonymous Claude quota example; production thresholds replace healthy color with amber or red.",
      "html": "<div class=\"ds-quota\"><div class=\"ds-quota-copy\"><span>5h limit</span><span>70% left</span></div><div class=\"ds-quota-track\" role=\"progressbar\" aria-label=\"5h remaining\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"70\"><div class=\"ds-quota-fill\"></div></div></div>",
      "css": ".ds-quota {font:400 12px/16px var(--app-font,sans-serif);color:var(--neutral-500,#676773);font-variant-numeric:tabular-nums;}.ds-quota-copy {display:flex;justify-content:space-between;margin-bottom:4px;}.ds-quota-track {height:6px;border-radius:9999px;overflow:hidden;background:var(--neutral-100,#eeeeef);}.ds-quota-fill {height:100%;width:70%;background:#d97757;transition:width 300ms;} @media(prefers-reduced-motion:reduce){.ds-quota-fill{transition:none;}}"
    }
  ],
  "narrative": {
    "northStar": "Familiar desktop utility",
    "overview": "Identity, verified remaining quota and the next action establish the hierarchy. The default macOS presentation uses quiet surfaces and system typography, with compact controls and aligned account rows. This is an operational desktop utility inside Tauri, with a React interface.\n\nWindows XP, Windows 7, Terminal, Paper, Nord and Mono are alternate presentations of the same controls. Theme selection changes the neutral ramp, accent, font and geometry together. A separate Light/Dark control applies to each of the seven identities; explicit mode selection persists and synchronizes to the tray. Fresh installations default to macOS light, while historical plain IDs and legacy light/dark storage preserve their original meaning. It does not change account behavior. The user's explicit familiar OS direction permits system fonts and authentic period chrome.",
    "keyCharacteristics": [
      "Identity before actions; remaining quota before advanced detail.",
      "Seven theme identities, each in light and dark mode, sharing one provider header and component structure.",
      "Provider accents and labeled status remain independent of theme accents.",
      "Turkish and English labels, wrapping actions and tabular account numerals."
    ],
    "rules": [
      {
        "name": "Theme Together",
        "body": "Apply the selected neutral ramp, font, radii and accent together. Light/dark selects surface roles without changing theme identity. Selecting another identity preserves the selected mode; legacy theme IDs retain their original default appearance.",
        "section": "colors"
      },
      {
        "name": "Provider and State",
        "body": "Keep provider identity distinct from quota warning and error states; accompany status color with a label or numerical value.",
        "section": "colors"
      },
      {
        "name": "Utility Hierarchy",
        "body": "Reserve emphasis for identity, dialog titles and actionable state; keep percentages and reset times readable alongside their labels.",
        "section": "typography"
      },
      {
        "name": "Period Chrome",
        "body": "Keep the existing XP and Aero gradients and bevels in their period themes; use the other themes' own flat or tonal materials elsewhere.",
        "section": "elevation"
      },
      {
        "name": "Common Provider Header",
        "body": "Keep privacy, refresh, warm-up, settings, account actions and automation controls in one header for both providers. Route commands and automation state to the selected provider; keep provider-specific launch and scheduling capabilities explicit.",
        "section": "navigation"
      }
    ],
    "dos": [
      "**Do** switch theme tokens together and preserve provider and warning semantics.",
      "**Do** keep identity, remaining quota and the next action visible before advanced settings.",
      "**Do** preserve visible keyboard focus, explicit status labels and locale-aware values.",
      "**Do** allow action rows and translated copy to wrap inside the shared content width.",
      "**Do** place the selected Code account under Active account for both providers, preserving the separate Claude Desktop profile status."
    ],
    "donts": [
      "**Don't** spread XP or Aero chrome into the other themes.",
      "**Don't** frame the account identity as an XP or Aero command button.",
      "**Don't** infer verified quota from a loading or unknown state.",
      "**Don't** use real account identities or credentials in documentation examples."
    ]
  }
}
